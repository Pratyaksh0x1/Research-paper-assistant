# Required for AI summaries and answers
GROQ_API_KEY=your_groq_api_key
LLM_MODEL=openai/gpt-oss-120b

# Optional: LlamaParse for fast, cloud-based PDF parsing, LaTeX equation extraction, and table formatting
# Get free API key from https://cloud.llamaindex.ai/ (1000 free pages/day)
LLAMA_CLOUD_API_KEY=your_llama_cloud_api_key

# Optional: set this to a Groq-supported vision model to describe extracted figures
GROQ_VISION_MODEL=

# Vector storage: choose ONE mode. Leave QDRANT_URL empty for embedded local Qdrant.
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=research_paper_chunks
QDRANT_LOCAL_PATH=./data/qdrant

# Embedding settings
EMBEDDING_BACKEND=sentence-transformers
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384
RETRIEVAL_SCORE_THRESHOLD=0.22
MAX_UPLOAD_MB=25
LOG_LEVEL=INFO
PORT=5000
